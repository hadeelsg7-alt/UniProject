# Copy this file to `.env` and fill in ONE provider. Never commit your real .env file.

# Which reasoning engine the agents use: anthropic | openai | offline
#   offline = transparent rule-based reasoner, no API key needed (also used automatically
#             if the selected provider has no key, or if an API call fails)
LLM_PROVIDER=anthropic

# --- Anthropic Claude (default) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- OpenAI (alternative) ---
OPENAI_API_KEY=
# Set to a model available to your account that supports structured outputs
OPENAI_MODEL=

# --- Optional tuning ---
LLM_MAX_TOKENS=8000
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=2.0
LLM_TIMEOUT=120
# Agent1 <-> Agent2 revision loop cap (0-2)
MAX_REVISIONS=2
# Fixed "today" for SLA checks, e.g. 2026-02-01 (leave empty to use the real date)
SLA_REFERENCE_DATE=
